# AriMar Gestión (solo servidor — Vercel o .env.local en desarrollo)
# URL pública HTTPS del backend (túnel o dominio), sin barra final
ARIMAR_API_URL=https://tu-tunel-o-dominio.ejemplo.com

# Cuenta de servicio con acceso al catálogo (no exponer en el cliente)
ARIMAR_LOGIN_EMAIL=web@ejemplo.com
ARIMAR_LOGIN_PASSWORD=cambiar-en-vercel
