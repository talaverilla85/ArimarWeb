# AriMar Gestión (solo servidor — Vercel o .env.local en desarrollo)
# URL HTTPS del frontend de Gestión (mismo host que en el navegador).
# Se añade /api-backend automáticamente salvo que apunte al puerto 8000.
# El dominio debe resolver en DNS público (Vercel no alcanza túneles solo locales).
ARIMAR_API_URL=https://gestion.arimarfoodlab.es

# Cuenta de servicio con acceso al catálogo (no exponer en el cliente)
ARIMAR_LOGIN_EMAIL=web@ejemplo.com
ARIMAR_LOGIN_PASSWORD=cambiar-en-vercel

# Google Places API — reseñas en la home (solo servidor)
# Crear clave en Google Cloud con Places API activada y restricción por IP/servidor.
GOOGLE_PLACES_API_KEY=
# Opcional: si la búsqueda automática no encuentra el negocio, pegar el Place ID aquí.
GOOGLE_PLACE_ID=
